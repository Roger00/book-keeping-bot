# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored and never committed. deploy.sh reads it to
# populate Google Secret Manager.

# --- LINE Messaging API (LINE Developers console) ---
CHANNEL_ACCESS_TOKEN=
CHANNEL_SECRET=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Google service account (from the service-account JSON key file) ---
GOOGLE_API_PROJECT_ID=
GOOGLE_API_PRIVATE_KEY_ID=
# Paste the full private key. Keep it on ONE line with literal \n between
# lines, exactly as it appears in the JSON file's "private_key" field, e.g.:
# GOOGLE_API_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_API_PRIVATE_KEY=
GOOGLE_API_CLIENT_EMAIL=
GOOGLE_API_CLIENT_ID=
